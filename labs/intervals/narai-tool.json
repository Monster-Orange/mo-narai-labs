{
  "id": "narai-labs/intervals",
  "version": "0.3.0",
  "sdk": "^1",
  "publisher": {
    "name": "Narai Labs",
    "url": "https://michinar.ai"
  },
  "surfaces": {
    "embed": {
      "url": "https://intervals.tools.michinar.dev/0.3.0/",
      "sdk": "^1"
    }
  },
  "preset_schema": "music.interval-preset@1",
  "answers": {
    "name_interval": "music.interval-named@1",
    "play_interval": "music.played@1"
  },
  "commands": {
    "replay": "music.none@1"
  },
  "state": "intervals.state@1",
  "assist": "honors",
  "locales": [
    "en",
    "ja"
  ],
  "capabilities": {
    "audio_out": true,
    "microphone": false,
    "network": "none"
  },
  "payloads": {
    "music.interval-preset@1": {
      "description": "What the trainer plays: one note (the learner plays the interval above it) or two (the learner names the interval). The notes are the sound, never the answer key: Narai holds the key and judges.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notes"
      ],
      "properties": {
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[A-G]#?-?\\d$"
          }
        }
      }
    },
    "music.interval-named@1": {
      "description": "The interval the learner named, as a short name (m3 is a minor third).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval"
      ],
      "properties": {
        "interval": {
          "enum": [
            "P1",
            "m2",
            "M2",
            "m3",
            "M3",
            "P4",
            "TT",
            "P5",
            "m6",
            "M6",
            "m7",
            "M7",
            "P8"
          ]
        }
      }
    },
    "intervals.state@1": {
      "description": "What the trainer plays (its preset's notes) and whether they are sounding now. Never what the learner did, and never the interval.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notes",
        "playing"
      ],
      "properties": {
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[A-G]#?-?\\d$"
          }
        },
        "playing": {
          "type": "boolean"
        }
      }
    },
    "music.played@1": {
      "$defs": {
        "Note": {
          "additionalProperties": false,
          "properties": {
            "pitch": {
              "description": "MIDI note number (60 is middle C)",
              "maximum": 127,
              "minimum": 0,
              "title": "Pitch",
              "type": "integer"
            },
            "at_ms": {
              "description": "ms from the task's start, as the tool heard it",
              "minimum": 0,
              "title": "At Ms",
              "type": "integer"
            },
            "string": {
              "anyOf": [
                {
                  "maximum": 12,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1 is the highest-pitched string",
              "title": "String"
            },
            "fret": {
              "anyOf": [
                {
                  "maximum": 36,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Fret"
            },
            "velocity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Velocity"
            }
          },
          "required": [
            "pitch",
            "at_ms"
          ],
          "title": "Note",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "music.played@1",
      "properties": {
        "notes": {
          "items": {
            "$ref": "#/$defs/Note"
          },
          "maxItems": 2000,
          "title": "Notes",
          "type": "array"
        },
        "latency_ms": {
          "anyOf": [
            {
              "description": "The latency the tool measured, in ms, sent with what it reports",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "notes"
      ],
      "title": "Played",
      "type": "object"
    },
    "music.none@1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
