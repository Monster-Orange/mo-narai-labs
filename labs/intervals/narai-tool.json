{
  "id": "narai-labs/intervals",
  "version": "0.4.0",
  "sdk": "^1",
  "publisher": {
    "name": "Narai Labs",
    "url": "https://michinar.ai"
  },
  "surfaces": {
    "embed": {
      "url": "https://intervals.tools.michinar.dev/0.4.0/",
      "sdk": "^1"
    }
  },
  "preset_schema": "music.interval-preset@1",
  "answers": {
    "name_interval": "music.interval-named@1",
    "play_interval": "music.played@1"
  },
  "commands": {
    "replay": "music.none@1"
  },
  "state": "intervals.state@1",
  "assist": "honors",
  "locales": [
    "en",
    "ja"
  ],
  "capabilities": {
    "audio_out": true,
    "microphone": false,
    "network": "none"
  },
  "payloads": {
    "music.interval-preset@1": {
      "additionalProperties": false,
      "description": "music.interval-preset@1: what an interval trainer plays, one pitch (the learner plays the interval above it) or\ntwo, low then high, an octave apart at most (the learner names it). The pitches are the sound, never the answer key:\nNarai holds the key and judges. That the two are in order and within an octave is not in this JSON Schema: Narai\nchecks it with its own model wherever a payload is checked.",
      "properties": {
        "notes": {
          "items": {
            "description": "MIDI note number (60 is middle C)",
            "maximum": 127,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "notes"
      ],
      "title": "IntervalPreset",
      "type": "object"
    },
    "music.interval-named@1": {
      "additionalProperties": false,
      "description": "music.interval-named@1: the interval the learner named, by its short name (m3 is a minor third). The semitones\nbetween the two pitches, never their direction: a descending major third is M3 too.",
      "properties": {
        "interval": {
          "enum": [
            "P1",
            "m2",
            "M2",
            "m3",
            "M3",
            "P4",
            "TT",
            "P5",
            "m6",
            "M6",
            "m7",
            "M7",
            "P8"
          ],
          "title": "Interval",
          "type": "string"
        }
      },
      "required": [
        "interval"
      ],
      "title": "IntervalNamed",
      "type": "object"
    },
    "intervals.state@1": {
      "description": "What the trainer plays (its preset's pitches, MIDI) and whether they are sounding now. Never what the learner did, and never the interval.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notes",
        "playing"
      ],
      "properties": {
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          }
        },
        "playing": {
          "type": "boolean"
        }
      }
    },
    "music.played@1": {
      "$defs": {
        "Note": {
          "additionalProperties": false,
          "properties": {
            "pitch": {
              "description": "MIDI note number (60 is middle C)",
              "maximum": 127,
              "minimum": 0,
              "title": "Pitch",
              "type": "integer"
            },
            "at_ms": {
              "description": "ms from the task's start, as the tool heard it",
              "minimum": 0,
              "title": "At Ms",
              "type": "integer"
            },
            "string": {
              "anyOf": [
                {
                  "maximum": 12,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1 is the highest-pitched string",
              "title": "String"
            },
            "fret": {
              "anyOf": [
                {
                  "maximum": 36,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Fret"
            },
            "velocity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Velocity"
            }
          },
          "required": [
            "pitch",
            "at_ms"
          ],
          "title": "Note",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "music.played@1",
      "properties": {
        "notes": {
          "items": {
            "$ref": "#/$defs/Note"
          },
          "maxItems": 2000,
          "title": "Notes",
          "type": "array"
        },
        "latency_ms": {
          "anyOf": [
            {
              "description": "The latency the tool measured, in ms, sent with what it reports",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "notes"
      ],
      "title": "Played",
      "type": "object"
    },
    "music.none@1": {
      "additionalProperties": false,
      "description": "music.none@1: no body",
      "properties": {},
      "title": "Empty",
      "type": "object"
    }
  }
}
