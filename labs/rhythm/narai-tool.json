{
  "id": "narai-labs/rhythm",
  "name": { "en": "Rhythm", "ja": "リズム" },
  "version": "0.2.3",
  "sdk": "^1",
  "publisher": {
    "name": "Narai Labs",
    "url": "https://michinar.ai"
  },
  "surfaces": {
    "embed": {
      "url": "https://rhythm.tools.michinar.dev/0.2.3/",
      "sdk": "^1"
    }
  },
  "preset_schema": "music.cycle-preset@1",
  "answers": {
    "tap_cycle": "music.taps@1"
  },
  "practice": {
    "free_tap": "music.taps@1"
  },
  "locales": [
    "en",
    "ja"
  ],
  "capabilities": {
    "audio_out": false,
    "microphone": false,
    "network": "none"
  },
  "payloads": {
    "music.cycle-preset@1": {
      "additionalProperties": false,
      "description": "music.cycle-preset@1: a rhythmic cycle as a step sets it up, a tala or a meter. The cycle's structure is here, not\nonly its name: `beats` in `groups` (a tala's divisions, a meter's bars), a clap or a wave per group, a syllable per\nbeat. Its rules across fields (the groups sum to the beats; one hand per group; one syllable per beat) are not in\nthis JSON Schema: Narai checks them with its own model wherever a payload is checked, and a tool must not take a\npreset that passes the schema alone as one Narai would send.",
      "properties": {
        "system": {
          "enum": [
            "tala",
            "meter"
          ],
          "title": "System",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rupak, adi, 4/4",
          "title": "Name"
        },
        "beats": {
          "maximum": 64,
          "minimum": 1,
          "title": "Beats",
          "type": "integer"
        },
        "groups": {
          "items": {
            "maximum": 64,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "hands": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "clap",
                  "wave"
                ],
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "one per group",
          "title": "Hands"
        },
        "syllables": {
          "anyOf": [
            {
              "items": {
                "maxLength": 16,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "one per beat",
          "title": "Syllables"
        },
        "subdivision": {
          "default": 1,
          "description": "pulses per beat",
          "maximum": 8,
          "minimum": 1,
          "title": "Subdivision",
          "type": "integer"
        },
        "tempo_bpm": {
          "maximum": 400,
          "minimum": 20,
          "title": "Tempo Bpm",
          "type": "integer"
        },
        "count_in_beats": {
          "default": 0,
          "description": "beats before the first; the clock starts after",
          "maximum": 16,
          "minimum": 0,
          "title": "Count In Beats",
          "type": "integer"
        },
        "cycles": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Cycles",
          "type": "integer"
        }
      },
      "required": [
        "system",
        "beats",
        "groups",
        "tempo_bpm"
      ],
      "title": "CyclePreset",
      "type": "object"
    },
    "music.taps@1": {
      "$defs": {
        "Tap": {
          "additionalProperties": false,
          "properties": {
            "at_ms": {
              "description": "ms from the first beat after the count-in, as the tool heard it",
              "minimum": 0,
              "title": "At Ms",
              "type": "integer"
            },
            "velocity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "how hard; carried, not judged in @1",
              "title": "Velocity"
            }
          },
          "required": [
            "at_ms"
          ],
          "title": "Tap",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "music.taps@1",
      "properties": {
        "taps": {
          "items": {
            "$ref": "#/$defs/Tap"
          },
          "maxItems": 2000,
          "title": "Taps",
          "type": "array"
        },
        "source": {
          "description": "how the tool heard the taps; `mic` is onsets the tool detected, never audio",
          "enum": [
            "touch",
            "key",
            "midi",
            "mic"
          ],
          "title": "Source",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "description": "The latency the tool measured, in ms, sent with what it reports",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "taps",
        "source"
      ],
      "title": "Taps",
      "type": "object"
    }
  }
}
