{
  "id": "narai-labs/fretboard",
  "version": "0.5.0",
  "sdk": "^1",
  "publisher": {
    "name": "Narai Labs",
    "url": "https://michinar.ai"
  },
  "surfaces": {
    "embed": {
      "url": "https://fretboard.tools.michinar.dev/0.5.0/",
      "sdk": "^1"
    }
  },
  "preset_schema": "music.neck-preset@1",
  "answers": {
    "play_target": "music.played@1"
  },
  "task_payloads": {
    "play_target": "music.notes@1"
  },
  "commands": {
    "highlight": "music.notes@1",
    "clear": "music.none@1"
  },
  "state": "music.neck-state@1",
  "assist": "honors",
  "locales": [
    "en",
    "ja"
  ],
  "capabilities": {
    "audio_out": true,
    "microphone": true,
    "network": "none"
  },
  "payloads": {
    "music.neck-preset@1": {
      "additionalProperties": false,
      "description": "music.neck-preset@1: a Neck, as a step sets it up",
      "properties": {
        "tuning": {
          "description": "MIDI pitch per string, lowest string first",
          "items": {
            "type": "integer"
          },
          "maxItems": 12,
          "minItems": 4,
          "title": "Tuning",
          "type": "array"
        },
        "frets": {
          "maximum": 36,
          "minimum": 12,
          "title": "Frets",
          "type": "integer"
        },
        "capo": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capo"
        },
        "handed": {
          "enum": [
            "right",
            "left"
          ],
          "title": "Handed",
          "type": "string"
        },
        "labels": {
          "enum": [
            "none",
            "notes",
            "intervals",
            "degrees"
          ],
          "title": "Labels",
          "type": "string"
        }
      },
      "required": [
        "tuning",
        "frets",
        "handed",
        "labels"
      ],
      "title": "NeckPreset",
      "type": "object"
    },
    "music.played@1": {
      "$defs": {
        "Note": {
          "additionalProperties": false,
          "properties": {
            "pitch": {
              "description": "MIDI note number (60 is middle C)",
              "maximum": 127,
              "minimum": 0,
              "title": "Pitch",
              "type": "integer"
            },
            "at_ms": {
              "description": "ms from the task's start, as the tool heard it",
              "minimum": 0,
              "title": "At Ms",
              "type": "integer"
            },
            "string": {
              "anyOf": [
                {
                  "maximum": 12,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1 is the highest-pitched string",
              "title": "String"
            },
            "fret": {
              "anyOf": [
                {
                  "maximum": 36,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Fret"
            },
            "velocity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Velocity"
            }
          },
          "required": [
            "pitch",
            "at_ms"
          ],
          "title": "Note",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "music.played@1",
      "properties": {
        "notes": {
          "items": {
            "$ref": "#/$defs/Note"
          },
          "maxItems": 2000,
          "title": "Notes",
          "type": "array"
        },
        "latency_ms": {
          "anyOf": [
            {
              "description": "The latency the tool measured, in ms, sent with what it reports",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "notes"
      ],
      "title": "Played",
      "type": "object"
    },
    "music.neck-state@1": {
      "$defs": {
        "Neck": {
          "additionalProperties": false,
          "description": "A neck's setup: the one shape `music.neck-preset@1` is and `music.neck-state@1` holds.",
          "properties": {
            "tuning": {
              "description": "MIDI pitch per string, lowest string first",
              "items": {
                "type": "integer"
              },
              "maxItems": 12,
              "minItems": 4,
              "title": "Tuning",
              "type": "array"
            },
            "frets": {
              "maximum": 36,
              "minimum": 12,
              "title": "Frets",
              "type": "integer"
            },
            "capo": {
              "anyOf": [
                {
                  "maximum": 12,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Capo"
            },
            "handed": {
              "enum": [
                "right",
                "left"
              ],
              "title": "Handed",
              "type": "string"
            },
            "labels": {
              "enum": [
                "none",
                "notes",
                "intervals",
                "degrees"
              ],
              "title": "Labels",
              "type": "string"
            }
          },
          "required": [
            "tuning",
            "frets",
            "handed",
            "labels"
          ],
          "title": "Neck",
          "type": "object"
        },
        "Position": {
          "additionalProperties": false,
          "properties": {
            "string": {
              "maximum": 12,
              "minimum": 1,
              "title": "String",
              "type": "integer"
            },
            "fret": {
              "maximum": 36,
              "minimum": 0,
              "title": "Fret",
              "type": "integer"
            },
            "label": {
              "anyOf": [
                {
                  "maxLength": 16,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Label"
            }
          },
          "required": [
            "string",
            "fret"
          ],
          "title": "Position",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "music.neck-state@1",
      "properties": {
        "preset": {
          "$ref": "#/$defs/Neck"
        },
        "highlighted": {
          "items": {
            "$ref": "#/$defs/Position"
          },
          "maxItems": 144,
          "title": "Highlighted",
          "type": "array"
        },
        "playing": {
          "title": "Playing",
          "type": "boolean"
        }
      },
      "required": [
        "preset",
        "playing"
      ],
      "title": "NeckState",
      "type": "object"
    },
    "music.notes@1": {
      "additionalProperties": false,
      "description": "music.notes@1: notes to show, pitches where they sound and pitch classes anywhere; the first (of `notes`, else of\n`classes`) is the root the labels count from. One of the two at least: that is not in this JSON Schema, Narai checks\nit with its own model.",
      "properties": {
        "notes": {
          "default": [],
          "items": {
            "description": "MIDI note number (60 is middle C)",
            "maximum": 127,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 24,
          "title": "Notes",
          "type": "array"
        },
        "classes": {
          "default": [],
          "items": {
            "description": "0 is C, 11 is B",
            "maximum": 11,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 12,
          "title": "Classes",
          "type": "array"
        }
      },
      "title": "Notes",
      "type": "object"
    },
    "music.none@1": {
      "additionalProperties": false,
      "description": "music.none@1: no body",
      "properties": {},
      "title": "Empty",
      "type": "object"
    }
  }
}
